# ============================================
# FitFlow - Variables de entorno
# ============================================
# Copia este archivo como .env y completa los valores
# NUNCA subas .env al repositorio (está en .gitignore)

# ---------- Users Service ----------
USERS_DB_USER=fitflow_user
USERS_DB_PASSWORD=cambia_esta_contraseña
USERS_DB_NAME=fitflow_users
USERS_DB_ROOT_PASSWORD=cambia_esta_root

# ---------- Booking Service ----------
BOOKING_DB_USER=fitflow_booking
BOOKING_DB_PASSWORD=cambia_esta_contraseña
BOOKING_DB_NAME=fitflow_bookings
BOOKING_DB_ROOT_PASSWORD=cambia_esta_root

# ---------- Notif Service ----------
NOTIF_DB_USER=fitflow_notif
NOTIF_DB_PASSWORD=cambia_esta_contraseña
NOTIF_DB_NAME=fitflow_notifications
NOTIF_DB_ROOT_PASSWORD=cambia_esta_root

# ---------- JWT ----------
JWT_SECRET=tu_jwt_secret_super_seguro_cambia_esto
JWT_EXPIRE_MINUTES=60

# ---------- MCP / Demo ----------
DEMO_USER_EMAIL=demo@fitflow.com
DEMO_USER_PASSWORD=demopass123